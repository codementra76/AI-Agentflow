# ===================================================================
# AgentFlow Environment Variables Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the real .env file into Git!
# ===================================================================

# Application Server
PORT=8085
SPRING_PROFILES_ACTIVE=local

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agentflow_db1
DB_USERNAME=your_mysql_username_here
DB_PASSWORD=your_mysql_password_here

# Alternative Full JDBC Datasource Override (Optional)
# SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/agentflow_db1?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# SPRING_DATASOURCE_USERNAME=your_mysql_username_here
# SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Database Migration & Logging
FLYWAY_ENABLED=true
JPA_SHOW_SQL=false

# Security / Token Keys (Placeholders)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_placeholder

# Local Ollama AI Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=60

